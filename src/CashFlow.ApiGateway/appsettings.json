{
  "ReverseProxy": {
    "Routes": [
      {
        "RouteId": "transaction-debit",
        "ClusterId": "transaction-api",
        "Match": {
          "Path": "/api/v1/account/debit"
        },
        "AuthorizationPolicy": "UserOnly"
      },
      {
        "RouteId": "transaction-credit",
        "ClusterId": "transaction-api",
        "Match": {
          "Path": "/api/v1/account/credit"
        },
        "AuthorizationPolicy": "UserOnly"
      }
    ],
    "Clusters": {
      "transaction-api": {
        "Destinations": {
          "transaction-api/destination": {
            "Address": "https://localhost:8087/"
          }
        }
      }
    }
  }
}