{
  "MySqlDB": {
    "ConnectionString": "Server=localhost;Database=accountDB;Uid=appuser;Pwd=appuserpass123;",
    "TimeoutSeconds": 30
  },
  "MongoDB": {
    "ConnectionString": "mongodb://root:example@localhost:27017",
    "Database": "EventStore",
    "TimeoutSeconds": 30
  },
  "Cache": {
    "Host": "localhost:6379",
    "ExpirationMinutes": 30
  },
  "Broker": {
    "Main": {
      "Host": "localhost",
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest",
      "Queues": {
        "InFlowProcessedEvent": {
          "Name": "InFlowProcessedEvent",
          "RetryCount": 3,
          "RetryInterval": "2",
          "DLQ": {
            "Exchange": "InFlowProcessedEvent-dlx",
            "Queue": "InFlowProcessedEvent-Failed",
            "Durable": true,
            "AutoDelete": false,
            "TTL": 86400000
          },
          "CircuitBreaker": {
            "TripThreshold": 5,
            "DurationOfBreak": "00:00:30"
          }
        },
        "DebitRequestedEvent": {
          "Name": "OutFlowProcessedEvent",
          "RetryCount": 3,
          "RetryInterval": "2",
          "DLQ": {
            "Exchange": "OutFlowProcessedEvent-dlx",
            "Queue": "OutFlowProcessedEvent-Failed",
            "Durable": true,
            "AutoDelete": false,
            "TTL": 86400000
          },
          "CircuitBreaker": {
            "TripThreshold": 5,
            "DurationOfBreak": "00:00:30"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Warning"
    }
  },
  "AllowedHosts": "*"
}
